# ---------------------------------------------------------------------------
# Handwriting Intelligence - example environment configuration.
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# All variables are optional; defaults are shown.
# ---------------------------------------------------------------------------

# Root directory that holds datasets and caches.
HWI_DATA_DIR=data

# Directory that holds trained artifacts (checkpoint + metadata + class set).
HWI_MODEL_DIR=models

# Path to the serialized predictor bundle used by the API / demo.
HWI_ARTIFACT_PATH=models/mnist_cnn/artifact.pt

# Logging
HWI_LOG_LEVEL=INFO
HWI_LOG_FORMAT=json

# API server
HWI_HOST=0.0.0.0
HWI_PORT=8000

# Request limits for the inference API
HWI_MAX_UPLOAD_BYTES=5242880
HWI_MAX_BATCH_SIZE=32
